# Supabase — copy this file to .env.local and fill in the values from your
# Supabase dashboard (Project Settings -> API). Never commit .env.local.

# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (Settings -> API Keys -> Publishable key, starts with "sb_publishable_").
# Safe to expose to the browser. Replaces the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privy — Shipd's primary user authentication and identity provider.
# Copy your app id from the Privy dashboard (Settings -> Basics -> App ID).
# Safe to expose to the browser (it is the public client identifier).
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad — blockchain deployment
# Server-side RPC endpoint for Monad Testnet (used by the protocol signer).
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Optional browser-exposed RPC override for on-chain reads and the user's
# wallet client. Falls back to the public Monad Testnet RPC when unset.
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=

# Protocol signer / deployer private key.
# This address is authorized on ShipdRegistry, WorkReceipt, and Reputation to
# record verifications, create receipts, and record reputation events
# (server-side only — read via MONAD_DEPLOYER_PRIVATE_KEY, never NEXT_PUBLIC).
# NEVER commit a real private key. Leave this blank in .env.example.
MONAD_DEPLOYER_PRIVATE_KEY=
