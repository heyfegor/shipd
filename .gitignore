# Environmental & Sensitive Files
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets.*

# OS & System Files
.DS_Store
Thumbs.db
desktop.ini
.thumbnail

# Dependencies & Build Artifacts
# Anchor dist/ and build/ to the repo root so they don't also ignore app
# routes like src/app/build/ (the Build Flow) or any nested dist/ segment.
node_modules/
/dist/
/build/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Reference & Competitive Screenshots (Excluded)
Reference/
references/

# Temporary Scraps & Root Assets (Excluded)
scraps/
/assets/

# Generated Screenshots & Screen Captures (Excluded)
**/Screenshot_*.jpg
**/Screenshot_*.png
**/Screenshot_*.jpeg

# Next.js
/.next/
/out/
*.tsbuildinfo
next-env.d.ts
.vercel
/coverage

# IDE & Editor Directories
.gemini/
.vscode/
.idea/

